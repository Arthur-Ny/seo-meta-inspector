# Service runtime
PORT=8080
BASE_PATH=/

# Use a local or development PostgreSQL database.
# Never put a production credential in this file.
DATABASE_URL=postgresql://user:password@localhost:5432/seo_meta_inspector

# Optional feedback delivery configuration
FEEDBACK_RECIPIENT_EMAIL=
FEEDBACK_FROM_EMAIL=

# Optional public AdSense identifiers
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_PRIMARY_SLOT=
VITE_ADSENSE_SECONDARY_SLOT=